{
  "name": "builtin.language-debug-node-monorepo",
  "version": "0.0.0-dev",
  "description": "Node.js debugger extension",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "build:extension": "node scripts/build-extension.js",
    "predev": "npm run build:extension",
    "dev": "node ./node_modules/@lvce-editor/server/bin/server.js --only-extension=packages/extension --test-path=packages/e2e",
    "pree2e": "npm run build:extension",
    "e2e": "cd packages/e2e && npm run e2e",
    "pree2e:headless": "npm run build:extension",
    "e2e:headless": "cd packages/e2e && npm run e2e:headless",
    "lint": "eslint . && prettier --check .",
    "test": "npm test --workspaces --if-present",
    "test:watch": "node --unhandled-rejections=warn --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "type-check": "tsc -b"
  },
  "author": {
    "name": "Le Vivilet",
    "email": "levivilet@pm.me"
  },
  "type": "module",
  "license": "MIT",
  "devDependencies": {
    "@lvce-editor/eslint-config": "^17.0.3",
    "@lvce-editor/package-extension": "^3.2.0",
    "@lvce-editor/server": "0.70.20",
    "@types/node": "^25.0.9",
    "eslint": "^10.7.0",
    "prettier": "^3.8.0",
    "typescript": "^6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
